@model List<DiemHocPhan>
@{
    ViewData["Title"] = "Danh sách điểm học phần";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>@ViewData["Title"]</h2>

<div class="mb-3">
    <p>Tổng số điểm học phần: <strong>@Model.Count</strong></p>
    <a asp-action="Create" class="btn btn-primary btn-action">
        <i class="bi bi-plus-circle"></i>
        <span class="ms-2">Thêm điểm học phần</span>
    </a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Họ và tên</th>
            <th>Mã sinh viên</th>
            <th>Tên học phần</th>
            <th>Mã học phần</th>
            <th>Điểm CC</th>
            <th>Điểm thi</th>
            <th>Điểm TB</th>
            <th>Xếp loại</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var diemhocphan in Model)
        {
            <tr>
                <td>@diemhocphan.Id</td>
                <td>@diemhocphan.SinhVien?.HoVaTen</td>
                <td>@diemhocphan.SinhVien?.MaSinhVien</td>
                <td>@diemhocphan.HocPhan?.TenHocPhan</td>
                <td>@diemhocphan.HocPhan?.MaHocPhan</td>
                <td class="text-center">@diemhocphan.DiemChuyenCan.ToString("0.0")</td>
                <td class="text-center">@diemhocphan.DiemThi.ToString("0.0")</td>
                <td class="text-center fw-bold">@diemhocphan.DiemTrungBinh.ToString("0.0")</td>
                <td class="text-center">
                    <span class="badge bg-@(diemhocphan.XepLoai == "Giỏi" ? "success" :
                          diemhocphan.XepLoai == "Khá" ? "primary" :
                          diemhocphan.XepLoai == "Trung Bình" ? "warning" : "danger")">
                        @diemhocphan.XepLoai
                    </span>
                </td>
                <td>
                    <a asp-controller="DiemHocPhan" asp-action="Details" asp-route-id="@diemhocphan.Id" class="btn btn-sm btn-primary">
                        Chi tiết
                    </a>
                    <a asp-controller="DiemHocPhan" asp-action="Edit" asp-route-id="@diemhocphan.Id" class="btn btn-sm btn-warning">
                        Chỉnh sửa
                    </a>
                    <a asp-controller="DiemHocPhan" asp-action="Delete" asp-route-id="@diemhocphan.Id" class="btn btn-sm btn-danger">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>