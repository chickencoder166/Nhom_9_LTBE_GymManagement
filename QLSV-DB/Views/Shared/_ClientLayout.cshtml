@{
    var isAdmin = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Hệ thống Quản Lý Phòng Gym" />
    <title>@ViewData["Title"] - Hệ Thống QLPG</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/client.css" asp-append-version="true" />
</head>
<body>
    <!-- Header/Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top shadow">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-dumbbell me-2"></i>
                <strong>QLPG - Quản Lý Phòng Gym</strong>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                           href="/Home/Index">
                            <i class="fas fa-home"></i> Trang chủ
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")"
                           href="/User/Index">
                            <i class="fas fa-users"></i> Hội viên
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "GoiTap" || ViewContext.RouteData.Values["controller"]?.ToString() == "Subcription" ? "active" : "")"
                           href="/GoiTap/Index">
                            <i class="fas fa-dumbbell"></i> Gói tập
                        </a>
                    </li>

                    <li class="nav-item">  =
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DangKyGoi" ? "active" : "")"
                           href="/DangKyGoi/Index">
                            <i class="fas fa-clipboard-list"></i> Đăng ký gói
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "TinTuc" ? "active" : "")"
                           href="/Home/TinTuc">
                            <i class="fas fa-bell"></i> Thông báo
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "LienHe" ? "active" : "")"
                           href="/Home/LienHe">
                            <i class="fas fa-envelope"></i> Liên hệ
                        </a>
                    </li>

                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" href="/Admin/Dashboard">
                                <i class="fas fa-user-shield"></i> Admin
                            </a>
                        </li>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Logout">
                                <i class="fas fa-sign-out-alt"></i> Đăng xuất
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Login">
                                <i class="fas fa-sign-in-alt"></i> Đăng nhập
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container my-4">
        <!-- Breadcrumb -->
        @if (ViewData["Title"] != null && ViewData["Title"]?.ToString() != "Trang chủ")
        {
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Home/Index">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                </ol>
            </nav>
        }

        <!-- Alert messages (TempData) -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5><i class="fas fa-dumbbell"></i> QLPG - Phòng Gym</h5>
                    <p class="small">Hệ thống Quản Lý Phòng Gym</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Liên hệ</h6>
                    <p class="small mb-0">
                        <i class="fas fa-map-marker-alt"></i> Số 1, Phố Xốm, Phường Phú Lương, Hà Đông, Hà Nội<br />
                        <i class="fas fa-phone"></i> 0961 595 599<br />
                        <i class="fas fa-envelope"></i> contact@qlpg.local
                    </p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Kết nối</h6>
                    <a href="#" class="text-white me-3"><i class="fab fa-facebook fa-2x"></i></a>
                    <a href="#" class="text-white me-3"><i class="fab fa-youtube fa-2x"></i></a>
                    <a href="#" class="text-white"><i class="fab fa-instagram fa-2x"></i></a>
                </div>
            </div>
            <hr class="bg-white" />
            <p class="mb-0">&copy; 2026 QLPG - Quản Lý Phòng Gym. All rights reserved.</p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/client.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
