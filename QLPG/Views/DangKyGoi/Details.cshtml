@model QLPG_a.Models.DangKyGoi
@{
    ViewData["Title"] = "Chi tiết đăng ký";
}

<div class="card p-3 shadow-sm">
    <h4>Chi tiết đăng ký</h4>
    <dl class="row">
        <dt class="col-sm-3">Mã đăng ký</dt><dd class="col-sm-9">@Model.MaDangKy</dd>
        <dt class="col-sm-3">Hội viên</dt><dd class="col-sm-9">@Model.User?.FullName</dd>
        <dt class="col-sm-3">Gói tập</dt><dd class="col-sm-9">@Model.Subcription?.TenGoi</dd>
        <dt class="col-sm-3">Ngày bắt đầuu</dt><dd class="col-sm-9">@Model.NgayBatDau.ToShortDateString()</dd>
        <dt class="col-sm-3">Ngày kết thúc</dt><dd class="col-sm-9">@Model.NgayKetThuc.ToShortDateString()</dd>
        <dt class="col-sm-3">Tính tiền</dt><dd class="col-sm-9">@Model.TongTien.ToString("N0") VN?</dd>
        <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@Model.TrangThai</dd>
    </dl>
    <p><a asp-action="Index" class="btn btn-secondary">Quay lại</a></p>
</div>