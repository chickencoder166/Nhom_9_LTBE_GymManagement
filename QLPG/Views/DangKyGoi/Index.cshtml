@model IEnumerable<QLPG_a.Models.DangKyGoi>
@{
    ViewData["Title"] = "Đăng ký gói";
}

<h2>Đăng ký gói</h2>
<p><a asp-controller="Admin" asp-action="RegisterSubscription" class="btn btn-info">Đăng ký gói cho hội viên</a></p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã đăng ký</th>
            <th>Hôi viên</th>
            <th>Gói</th>
            <th>Ngày bắt đầu</th>
            <th>Ngày kết thúc</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach(var d in Model){
        <tr>
            <td>@d.MaDangKy</td>
            <td>@d.User?.FullName</td>
            <td>@d.Subcription?.TenGoi</td>
            <td>@d.NgayBatDau.ToShortDateString()</td>
            <td>@d.NgayKetThuc.ToShortDateString()</td>
            <td>@d.TrangThai</td>
            <td>
                <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
            </td>
        </tr>
    }
    </tbody>
</table>