@{
    ViewData["Title"] = "Báo cáo thống kê";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-4"><i class="fas fa-chart-bar"></i> Báo Cáo Thống Kê</h2>

<!-- Statistics Overview -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <i class="fas fa-users fa-3x text-primary mb-3"></i>
                <h3 class="fw-bold">1,234</h3>
                <p class="text-muted mb-0">Tổng Sinh Viên</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <i class="fas fa-book fa-3x text-success mb-3"></i>
                <h3 class="fw-bold">45</h3>
                <p class="text-muted mb-0">Môn Học</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <i class="fas fa-star fa-3x text-warning mb-3"></i>
                <h3 class="fw-bold">8.5</h3>
                <p class="text-muted mb-0">Điểm TB Chung</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <i class="fas fa-percentage fa-3x text-info mb-3"></i>
                <h3 class="fw-bold">95%</h3>
                <p class="text-muted mb-0">Tỷ Lệ Đậu</p>
            </div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-chart-pie"></i> Phân Bố Sinh Viên Theo Lớp</h5>
            </div>
            <div class="card-body">
                <canvas id="classDistributionChart" height="300"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-chart-line"></i> Điểm Trung Bình Theo Môn</h5>
            </div>
            <div class="card-body">
                <canvas id="gradeDistributionChart" height="300"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-chart-bar"></i> Kết Quả Học Tập Theo Học Kỳ</h5>
            </div>
            <div class="card-body">
                <canvas id="semesterResultsChart" height="150"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Top Students -->
<div class="row g-4 mt-2">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-trophy text-warning"></i> Top 10 Sinh Viên Xuất Sắc</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Hạng</th>
                                <th>Mã SV</th>
                                <th>Họ Tên</th>
                                <th>Điểm TB</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="badge bg-warning">1</span></td>
                                <td>SV001</td>
                                <td>Nguyễn Văn A</td>
                                <td><strong>9.5</strong></td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-secondary">2</span></td>
                                <td>SV002</td>
                                <td>Trần Thị B</td>
                                <td><strong>9.3</strong></td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-secondary">3</span></td>
                                <td>SV003</td>
                                <td>Lê Văn C</td>
                                <td><strong>9.1</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-exclamation-triangle text-danger"></i> Sinh Viên Cần Chú Ý</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Mã SV</th>
                                <th>Họ Tên</th>
                                <th>Điểm TB</th>
                                <th>Ghi Chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>SV100</td>
                                <td>Phạm Văn X</td>
                                <td><span class="text-danger">4.5</span></td>
                                <td><span class="badge bg-danger">Cảnh báo học vụ</span></td>
                            </tr>
                            <tr>
                                <td>SV101</td>
                                <td>Hoàng Thị Y</td>
                                <td><span class="text-warning">5.2</span></td>
                                <td><span class="badge bg-warning">Yếu</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        new Chart(document.getElementById('classDistributionChart'), {
            type: 'pie',
            data: {
                labels: ['CNTT01', 'CNTT02', 'KTPM01', 'KTPM02', 'KHMT01'],
                datasets: [{
                    data: [250, 230, 200, 220, 210],
                    backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1']
                }]
            }
        });

        new Chart(document.getElementById('gradeDistributionChart'), {
            type: 'bar',
            data: {
                labels: ['Toán', 'Lý', 'Hóa', 'Anh', 'Tin'],
                datasets: [{
                    label: 'Điểm TB',
                    data: [7.5, 8.0, 7.8, 8.5, 9.0],
                    backgroundColor: '#0d6efd'
                }]
            },
            options: {
                scales: {
                    y: { beginAtZero: true, max: 10 }
                }
            }
        });

        new Chart(document.getElementById('semesterResultsChart'), {
            type: 'line',
            data: {
                labels: ['HK1-2023', 'HK2-2023', 'HK1-2024', 'HK2-2024', 'HK1-2025'],
                datasets: [{
                    label: 'Điểm TB',
                    data: [7.2, 7.5, 7.8, 8.0, 8.3],
                    borderColor: '#0d6efd',
                    tension: 0.4
                }]
            }
        });
    </script>
}
