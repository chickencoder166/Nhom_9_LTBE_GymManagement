@model QLPG_a.Models.ViewModels.ReportsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Báo cáo thống kê";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var revenueLabels = Model.Revenues.Select(r => $"{r.Month:00}/{r.Year}").ToList();
    var revenueTotals = Model.Revenues.Select(r => r.Total).ToList();
    var topLabels = Model.TopPackages.Select(p => p.PackageName).ToList();
    var topCounts = Model.TopPackages.Select(p => p.RegistrationCount).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fas fa-chart-bar"></i> Báo cáo thống kê</h2>
    <div>
        <a asp-action="ExportMembersExcel" class="btn btn-success btn-sm me-2">
            <i class="fas fa-file-excel"></i> Xuất danh sách hội viên
        </a>
        <a asp-action="ExportRevenueExcel" class="btn btn-success btn-sm">
            <i class="fas fa-file-excel"></i> Xuất báo cáo doanh thu
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <i class="fas fa-user-check fa-3x text-success mb-3"></i>
                <h3 class="fw-bold">@Model.ActiveMembers</h3>
                <p class="text-muted mb-0">Hội viên đang hoạt động</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <i class="fas fa-user-clock fa-3x text-danger mb-3"></i>
                <h3 class="fw-bold">@Model.ExpiredMembers</h3>
                <p class="text-muted mb-0">Hội viên hết hạn</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <i class="fas fa-coins fa-3x text-warning mb-3"></i>
                <h3 class="fw-bold">@Model.Revenues.Sum(x => x.Total).ToString("N0")</h3>
                <p class="text-muted mb-0">Tổng doanh thu thống kê (VNĐ)</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-headerbg-dark text-white">
                <h5 class="mb-0"><i class="fas fa-chart-line"></i> Doanh thu theo tháng</h5>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" height="120"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-headerbg-dark text-white">
                <h5 class="mb-0"><i class="fas fa-chart-pie"></i> Trạng thái hội viên</h5>
            </div>
            <div class="card-body d-flex justify-content-center">
                <canvas id="memberStatusChart" style="max-height:200px;"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-headerbg-dark text-white">
                <h5 class="mb-0"><i class="fas fa-medal"></i> Top 3 gói tập</h5>
            </div>
            <div class="card-body">
                <canvas id="topPackagesChart" height="200"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="fas fa-list"></i> Chi tiết top gói tập</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped align-middle text-white">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Gói tập</th>
                                <th>Số lượt ĐK</th>
                                <th>Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.TopPackages.Any())
                        {
                            @for (var i = 0; i < Model.TopPackages.Count; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@Model.TopPackages[i].PackageName</td>
                                    <td>@Model.TopPackages[i].RegistrationCount</td>
                                    <td>@Model.TopPackages[i].Revenue.ToString("N0") VNĐ</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted">Chưa có dữ liệu.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const revenueLabels = @Html.Raw(JsonSerializer.Serialize(revenueLabels));
        const revenueTotals = @Html.Raw(JsonSerializer.Serialize(revenueTotals));
        const topLabels = @Html.Raw(JsonSerializer.Serialize(topLabels));
        const topCounts = @Html.Raw(JsonSerializer.Serialize(topCounts));

        // Line chart: revenue by month
        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: revenueLabels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: revenueTotals,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13,110,253,0.15)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });

        // Pie chart: active vs expired members
        new Chart(document.getElementById('memberStatusChart'), {
            type: 'pie',
            data: {
                labels: ['Đang hoạt động', 'Hết hạn'],
                datasets: [{
                    data: [@Model.ActiveMembers, @Model.ExpiredMembers],
                    backgroundColor: ['#198754', '#dc3545']
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });

        // Bar chart: top packages
        new Chart(document.getElementById('topPackagesChart'), {
            type: 'bar',
            data: {
                labels: topLabels,
                datasets: [{
                    label: 'Số đăng ký',
                    data: topCounts,
                    backgroundColor: ['#0d6efd', '#198754', '#ffc107']
                }]
            },
            options: {
                indexAxis: 'y',
                scales: { x: { beginAtZero: true } },
                plugins: { legend: { display: false } }
            }
        });
    </script>
}
