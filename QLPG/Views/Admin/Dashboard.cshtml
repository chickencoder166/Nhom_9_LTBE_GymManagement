@model QLPG_a.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Statistics Cards -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Tổng Tài Khoản</h6>
                        <h2 class="mb-0 fw-bold">@Model.TotalUsers</h2>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded">
                        <i class="fas fa-user-cog fa-2x text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Tổng Hội Viên</h6>
                        <h2 class="mb-0 fw-bold">@Model.TotalMembers</h2>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded">
                        <i class="fas fa-users fa-2x text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Gói Đang Hoạt Động</h6>
                        <h2 class="mb-0 fw-bold">@Model.ActiveSubscriptionsCount</h2>
                    </div>
                    <div class="bg-info bg-opacity-10 p-3 rounded">
                        <i class="fas fa-dumbbell fa-2x text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Doanh Thu (6 tháng)</h6>
                        <h2 class="mb-0 fw-bold">
                            @((Model.Revenues != null && Model.Revenues.Any()) ? Model.Revenues.Sum(r => r.Total).ToString("N0") + " VNĐ" : "0 VNĐ")
                        </h2>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded">
                        <i class="fas fa-receipt fa-2x text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Hoạt Động Gần Đây</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-dark text-white">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Hoạt động</th>
                                <th>Người thực hiện</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>10:30 - 13/01/2026</td>
                                <td><i class="fas fa-user-plus text-success"></i> Thêm hội viên mới</td>
                                <td>Admin User</td>
                            </tr>
                            <tr>
                                <td>09:15 - 13/01/2026</td>
                                <td><i class="fas fa-pen-fancy text-primary"></i> Cập nhật gói tập</td>
                                <td>Admin User</td>
                            </tr>
                            <tr>
                                <td>08:45 - 13/01/2026</td>
                                <td><i class="fas fa-trash text-danger"></i> Xóa đăng ký gói</td>
                                <td>Admin User</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-headerbg-dark text-white">
                <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Thao Tác Nhanh</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/User/Create" class="btn btn-primary">
                        <i class="fas fa-user-plus"></i> Thêm Hội Viên
                    </a>
                    <a href="/Admin/Members" class="btn btn-outline-primary">
                        <i class="fas fa-users"></i> Danh Sách Hội Viên
                    </a>
                    <a href="/Admin/DangKiGoiTaps" class="btn btn-outline-success">
                        <i class="fas fa-dumbbell"></i> Quản Lý Gói Tập
                    </a>
                    <a href="/Admin/RegisterDangKiGoiTap" class="btn btn-outline-info">
                        <i class="fas fa-clipboard-list"></i> Đăng Ký Gói Cho Hội Viên
                    </a>
                    <a href="/Admin/Reports" class="btn btn-outline-warning">
                        <i class="fas fa-chart-line"></i> Thống Kê
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
