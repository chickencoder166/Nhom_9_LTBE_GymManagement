@model QLPG_a.Models.DangKiGoi
@{
    ViewData["Title"] = "Đăng ký gói tập cho hội viên";
}

<h2>Đăng ký gói cho hội viên</h2>
<form asp-action="RegisterDangKiGoiTap" method="post" asp-controller="Admin">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">Mã Đăng ký</label>
        <input asp-for="MaDangKy" class="form-control" />
        <span asp-validation-for="MaDangKy" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Chọn hội viên</label>
        <select asp-for="MemberId" class="form-select">
            <option value="">-- Chọn --</option>
            @foreach(var m in (List<QLPG_a.Models.Member>)ViewBag.Members!){
                <option value="@m.Id">@m.FullName (@m.MembershipNumber)</option>
            }
        </select>
        <span asp-validation-for="MemberId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Chọn gói</label>
        <select asp-for="GoiTapId" class="form-select">
            <option value="">-- Chọn --</option>
            @foreach(var g in (List<QLPG_a.Models.GoiTap>)ViewBag.GoiTaps!){
                <option value="@g.Id">@g.TenGoi - @g.Gia.ToString("N0") VND</option>
            }
        </select>
        <span asp-validation-for="GoiTapId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Ngày bắt đầu</label>
        <input asp-for="NgayBatDau" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="NgayBatDau" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Ghi chú</label>
        <textarea asp-for="GhiChu" class="form-control"></textarea>
    </div>
    <button class="btn btn-primary">Đăng ký</button>
</form>