@model QLPG_a.Models.GoiTap

@{
    ViewData["Title"] = "Xóa gói tập";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-light mb-3">Xóa gói tập</h2>

<div class="alert alert-warning">
    Bạn có chắc muốn xóa gói tập này không?
</div>

<div class="card p-3 shadow-sm">
    <dl class="row mb-0">
        <dt class="col-sm-3">Mã gói</dt>
        <dd class="col-sm-9">@Model.MaGoiTap</dd>

        <dt class="col-sm-3">Tên gói</dt>
        <dd class="col-sm-9">@Model.TenGoi</dd>

        <dt class="col-sm-3">Thời hạn</dt>
        <dd class="col-sm-9">@Model.ThoiHan</dd>

        <dt class="col-sm-3">Giá</dt>
        <dd class="col-sm-9">@Model.Gia.ToString("N0") VNĐ</dd>
    </dl>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
</form>
