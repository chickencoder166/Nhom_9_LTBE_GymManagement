@model IEnumerable<QLPG_a.Models.Member>
@{
    ViewData["Title"] = "Danh sách hội viên";
    var status = ViewData["FilterStatus"]?.ToString() ?? "all";
}

<h2 class="mb-3">Danh sách hội viên</h2>
<p class="text-muted">Bộ lọc hiện tại: <strong>@status</strong></p>

<div class="table-responsive">
    <table class="table table-striped text-white">
        <thead>
            <tr>
                <th>Mã hội viên</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>SĐT</th>
                <th>Ngày tham gia</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MembershipNumber</td>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.JoinDate?.ToString("dd/MM/yyyy")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
