<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - QLPG Gym</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="QLPG Gym - Quản lý phòng gym chuyên nghiệp" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Site styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100 bg-dark text-light">
    @{
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var isAdmin = User.IsInRole("Admin");
        var isMember = User.IsInRole("Member");
        var displayName = User.Identity?.Name ?? "Tài khoản";
    }

    <header class="mb-4">
        <nav class="navbar navbar-expand-lg navbar-dark border-bottom border-secondary app-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-dumbbell fs-4 text-danger" aria-hidden="true"></i>
                    <span class="fw-bold text-danger ms-2">Phòng gym đẳng cấp 5 sao</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="DangKiGois">Gói tập</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="TinTuc">Tin tức</a>
                        </li>

                        @if (isAuthenticated && isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="User" asp-action="Index">Người dùng</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="GoiTap" asp-action="Index">Quản lý gói</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DangKiGoi" asp-action="Index">Đăng ký gói</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="bi bi-shield-lock me-1"></i>Admin
                                </a>
                            </li>
                        }

                        @if (isAuthenticated && isMember)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Member" asp-action="Index">Hội viên</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (isAuthenticated)
                        {
                            <div class="dropdown">
                                <a class="btn btn-outline-light btn-sm dropdown-toggle" href="#" data-bs-toggle="dropdown">@displayName</a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            <a class="btn btn-danger btn-sm" asp-controller="Account" asp-action="Register">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        <div class="container mb-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show app-alert" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show app-alert" role="alert">
                    <i class="bi bi-x-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show app-alert" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Warning"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
        @RenderBody()
    </main>

    <footer class="bg-dark text-light pt-5 pb-4 mt-5 border-top border-secondary">
        <div class="container">
            <div class="row gy-3">
                <div class="col-md-4">
                    <h5 class="text-danger fw-bold">QLPG GYM</h5>
                    <p class="small text-muted">Hệ thống quản lý phòng gym chuyên nghiệp — quản lý hội viên, gói tập và lịch huấn luyện.</p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-semibold">Liên hệ</h6>
                    <ul class="list-unstyled small text-muted">
                        <li>Địa chỉ: 123 Đường Thể Thao, Hà Nội</li>
                        <li>Hotline: 0123 456 789</li>
                        <li>Email: info@qlpg.local</li>
                    </ul>
                </div>
                <div class="col-md-4 text-md-end">
                    <h6 class="fw-semibold">Theo dõi chúng tôi</h6>
                    <div class="mt-2">
                        <a class="btn btn-outline-light btn-sm me-2" href="#"><i class="fab fa-facebook-f"></i></a>
                        <a class="btn btn-outline-light btn-sm me-2" href="#"><i class="fab fa-instagram"></i></a>
                        <a class="btn btn-outline-light btn-sm" href="#"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12 text-center small text-muted">© 2026 QLPG. All rights reserved.</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
