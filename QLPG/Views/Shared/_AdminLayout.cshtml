<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Gym</title>
    
    <!-- Bootstrap 5 CSS (local template) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Site CSS (admin reuses site.css for consistent UI) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <aside class="sidebar bg-dark text-white" id="sidebar">
            <div class="sidebar-header p-3 border-bottom border-secondary">
                <h4 class="mb-0">
                    <i class="fas fa-dumbbell me-2"></i>
                    <strong>Gym Admin</strong>
                </h4>
            </div>
            <nav class="sidebar-nav">
                <ul class="nav flex-column">
                    @{
                        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
                        var act  = ViewContext.RouteData.Values["action"]?.ToString();
                    }
                    <li class="nav-item">
                        <a class="nav-link @(ctrl == "Admin" && act == "Dashboard" ? "active" : "")"
                           asp-controller="Admin" asp-action="Dashboard">
                            <i class="fas fa-tachometer-alt"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>

                    <li class="nav-item sidebar-section-label mt-3 ps-3 text-uppercase text-secondary small">
                        <small>Quản lý</small>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ctrl == "Admin" && act == "Members" ? "active" : "")"
                           asp-controller="Admin" asp-action="Members">
                            <i class="fas fa-users"></i>
                            <span>Hội viên</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ctrl == "GoiTap" ? "active" : "")"
                           asp-controller="GoiTap" asp-action="Index">
                            <i class="fas fa-box-open"></i>
                            <span>Gói tập</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ctrl == "DangKiGoi" ? "active" : "")"
                           asp-controller="DangKiGoi" asp-action="Index">
                            <i class="fas fa-clipboard-list"></i>
                            <span>Đăng ký gói</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ctrl == "Admin" && act == "RegisterDangKiGoiTap" ? "active" : "")"
                           asp-controller="Admin" asp-action="RegisterDangKiGoiTap">
                            <i class="fas fa-plus-circle"></i>
                            <span>Đăng ký mới</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ctrl == "User" ? "active" : "")"
                           asp-controller="User" asp-action="Index">
                            <i class="fas fa-user-cog"></i>
                            <span>Tài khoản</span>
                        </a>
                    </li>

                    <li class="nav-item sidebar-section-label mt-3 ps-3 text-uppercase text-secondary small">
                        <small>Báo cáo</small>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ctrl == "Admin" && act == "Reports" ? "active" : "")"
                           asp-controller="Admin" asp-action="Reports">
                            <i class="fas fa-chart-line"></i>
                            <span>Thống kê</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="ExportRevenueExcel">
                            <i class="fas fa-file-excel"></i>
                            <span>Xuất doanh thu</span>
                        </a>
                    </li>

                    <li class="nav-item mt-4 pt-4 border-top border-secondary">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-arrow-left"></i>
                            <span>Về Trang Chủ</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main content area -->
        <div class="main-content">
            <!-- Top navbar -->
            <nav class="navbar navbar-lightbg-dark text-white shadow-sm px-4">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link d-md-none" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <nav aria-label="breadcrumb" class="mb-0">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Admin</a></li>
                            @if (ViewData["Title"] != null && ViewData["Title"]?.ToString() != "Dashboard")
                            {
                                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                            }
                        </ol>
                    </nav>
                </div>
                <div class="dropdown">
                    <button class="btn btn-link text-decoration-none dropdown-toggle" type="button" 
                            id="userDropdown" data-bs-toggle="dropdown">
                        <i class="fas fa-user-circle fa-2x text-primary"></i>
                        <span class="ms-2 text-light">@User.Identity?.Name</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a></li>
                    </ul>
                </div>
            </nav>

            <!-- Page content -->
            <div class="container-fluid py-4">
                <!-- Alert messages -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <i class="fas fa-triangle-exclamation"></i> @TempData["Warning"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Body -->
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Scripts: use local template assets -->
    <script src="~/js/jquery.min.js" asp-append-version="true"></script>
    <script src="~/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/wow.js" asp-append-version="true"></script>
    <script src="~/js/parallax.js" asp-append-version="true"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
