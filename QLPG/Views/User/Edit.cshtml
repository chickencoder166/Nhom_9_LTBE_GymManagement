@model QLPG_a.Models.User
@{
    ViewData["Title"] = "Sửa hội viên";
}

<h2>Sửa hội viên</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">Mã hội viên</label>
        <input asp-for="MembershipNumber" class="form-control" />
        <span asp-validation-for="MembershipNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Tên đăng nhập</label>
        <input asp-for="UserName" class="form-control" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Họ tên</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">SĐT</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Vai trò</label>
        <select asp-for="Role" class="form-select">
            <option value="Member">Member</option>
            <option value="Admin">Admin</option>
        </select>
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.AvatarPath))
    {
        <div class="mb-3">
            <label class="form-label d-block">Ảnh hiện tại</label>
            <img src="@Model.AvatarPath" alt="Avatar" style="width:72px;height:72px;object-fit:cover;border-radius:999px;" />
        </div>
    }

    <div class="mb-3">
        <label class="form-label">Đổi ảnh đại diện</label>
        <input asp-for="AvatarFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
        <span asp-validation-for="AvatarFile" class="text-danger"></span>
    </div>

    <button class="btn btn-success">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
