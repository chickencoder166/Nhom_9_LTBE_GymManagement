@model QLPG_a.Models.User

@{
    ViewData["Title"] = "Xóa người dùng";
}

<h2 class="mb-3">Xóa người dùng</h2>

<div class="alert alert-warning">
    Bạn có chắc muốn xóa người dùng này không?
</div>

<div class="card p-3 shadow-sm mb-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Mã hội viên</dt>
        <dd class="col-sm-9">@Model.MembershipNumber</dd>

        <dt class="col-sm-3">Tên đăng nhập</dt>
        <dd class="col-sm-9">@Model.UserName</dd>

        <dt class="col-sm-3">Họ tên</dt>
        <dd class="col-sm-9">@Model.FullName</dd>

        <dt class="col-sm-3">Vai trò</dt>
        <dd class="col-sm-9">@Model.Role</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
</form>
