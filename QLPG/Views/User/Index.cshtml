@model IEnumerable<QLPG_a.Models.User>
@{
    ViewData["Title"] = "Quản lý tài khoản";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string sort = (ViewData["Sort"]?.ToString() ?? "name").ToLowerInvariant();
    string dir = (ViewData["Dir"]?.ToString() ?? "asc").ToLowerInvariant();
    string query = ViewData["Query"]?.ToString() ?? "";

    string SortLink(string col)
    {
        var nextDir = (sort == col && dir == "asc") ? "desc" : "asc";
        return Url.Action("Index", new { q = query, sort = col, dir = nextDir }) ?? "#";
    }

    string SortIcon(string col)
    {
        if (sort != col) return "<i class='fas fa-sort text-muted ms-1'></i>";
        return dir == "asc"
            ? "<i class='fas fa-sort-up ms-1'></i>"
            : "<i class='fas fa-sort-down ms-1'></i>";
    }
}

<h2 class="mb-3">Quản lý tài khoản</h2>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input name="q" value="@query" class="form-control" placeholder="Tìm theo mã, tên đăng nhập, họ tên, SĐT, email..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary"><i class="fas fa-search"></i> Tìm</button>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

<a asp-action="Create" class="btn btn-primary mb-3">
    <i class="fas fa-user-plus"></i> Thêm tài khoản
</a>

<table class="table table-striped table-bordered align-middle text-white">
    <thead>
        <tr>
            <th>Avatar</th>
            <th>
                <a href="@SortLink("code")" class="text-dark text-decoration-none">
                    Mã @Html.Raw(SortIcon("code"))
                </a>
            </th>
            <th>
                <a href="@SortLink("username")" class="text-dark text-decoration-none">
                    Tên đăng nhập @Html.Raw(SortIcon("username"))
                </a>
            </th>
            <th>
                <a href="@SortLink("name")" class="text-dark text-decoration-none">
                    Họ tên @Html.Raw(SortIcon("name"))
                </a>
            </th>
            <th>
                <a href="@SortLink("role")" class="text-dark text-decoration-none">
                    Vai trò @Html.Raw(SortIcon("role"))
                </a>
            </th>
            <th style="width: 220px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Không có dữ liệu tài khoản.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.AvatarPath))
                        {
                            <img src="@item.AvatarPath" alt="Avatar" style="width:40px;height:40px;object-fit:cover;border-radius:999px;" />
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>@item.MembershipNumber</td>
                    <td>@item.UserName</td>
                    <td>@item.FullName</td>
                    <td><span class="badge bg-secondary">@item.Role</span></td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Xem</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
