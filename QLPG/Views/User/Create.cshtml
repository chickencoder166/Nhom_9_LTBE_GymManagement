@model QLPG_a.Models.User
@{
    ViewData["Title"] = "Thêm hội viên";
}

<h2>Thêm hội viên</h2>
<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">Mã</label>
        <input asp-for="MembershipNumber" class="form-control" />
        <span asp-validation-for="MembershipNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Tên đăng nhập</label>
        <input asp-for="UserName" class="form-control" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Mật khẩu</label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Họ tên</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">SĐT</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Ảnh đại diện</label>
        <input asp-for="AvatarFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
        <span asp-validation-for="AvatarFile" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Vai trò</label>
        <select asp-for="Role" class="form-select">
            <option value="Member">Member</option>
            <option value="Admin">Admin</option>
        </select>
    </div>
    <button class="btn btn-primary">Lưu</button>
</form>