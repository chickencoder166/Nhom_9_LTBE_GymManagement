@model IEnumerable<QLPG_a.Models.DangKiGoi>
@{
    ViewData["Title"] = "Đăng ký gói";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var sort = ViewData["Sort"]?.ToString() ?? "";
    var dir = ViewData["Dir"]?.ToString() ?? "asc";

    string SortLink(string col)
    {
        var newDir = (sort == col && dir == "asc") ? "desc" : "asc";
        return $"?sort={col}&dir={newDir}";
    }
    string SortIcon(string col)
    {
        if (sort != col) return "<i class='fas fa-sort text-muted ms-1'></i>";
        return dir == "asc" ? "<i class='fas fa-sort-up ms-1'></i>" : "<i class='fas fa-sort-down ms-1'></i>";
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Quản lý đăng ký gói tập</h2>
    <a asp-controller="Admin" asp-action="RegisterDangKiGoiTap" class="btn btn-info">
        <i class="fas fa-plus"></i> Đăng ký gói cho hội viên
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle text-white">
        <thead class="table-dark">
            <tr>
                <th>Mã ĐK</th>
                <th><a href="@SortLink("member")" class="text-white text-decoration-none">Hội viên @Html.Raw(SortIcon("member"))</a></th>
                <th><a href="@SortLink("goi")" class="text-white text-decoration-none">Gói tập @Html.Raw(SortIcon("goi"))</a></th>
                <th><a href="@SortLink("start")" class="text-white text-decoration-none">Ngày bắt đầu @Html.Raw(SortIcon("start"))</a></th>
                <th>Ngày kết thúc</th>
                <th>Tổng tiền</th>
                <th><a href="@SortLink("status")" class="text-white text-decoration-none">Trạng thái @Html.Raw(SortIcon("status"))</a></th>
                <th style="width:140px">Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var d in Model)
        {
            <tr>
                <td>@d.MaDangKy</td>
                <td>@d.Member?.FullName</td>
                <td>@d.GoiTap?.TenGoi</td>
                <td>@d.NgayBatDau.ToString("dd/MM/yyyy")</td>
                <td>@d.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                <td>@d.TongTien.ToString("N0") VNĐ</td>
                <td>
                    <span class="badge @(d.TrangThai == "Đang hoạt động" ? "bg-success" : "bg-secondary")">
                        @d.TrangThai
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary" title="Chi tiết">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary" title="Sửa">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@d.Id" class="btn btn-sm btn-outline-danger" title="Xóa">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<p class="text-muted small">Tổng: @Model.Count() đăng ký</p>