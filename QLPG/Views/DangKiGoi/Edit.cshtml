@model QLPG_a.Models.DangKiGoi
@{
    ViewData["Title"] = "Sửa đăng ký";
}

<div class="row">
    <div class="col-md-8">
        <div class="card p-3 shadow-sm">
            <h4>Sửa đăng ký</h4>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label class="form-label">Mã đăng ký</label>
                    <input asp-for="MaDangKy" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Hội viên</label>
                    <select asp-for="MemberId" class="form-select">
                        @foreach(var m in (List<QLPG_a.Models.Member>)ViewData["Members"]!)
                        {
                            if(m.Id == Model.MemberId)
                            {
                                <option value="@m.Id" selected>@m.FullName (@m.MembershipNumber)</option>
                            }
                            else
                            {
                                <option value="@m.Id">@m.FullName (@m.MembershipNumber)</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Gói tập</label>
                    <select asp-for="GoiTapId" class="form-select">
                        @foreach(var g in (List<QLPG_a.Models.GoiTap>)ViewData["GoiTaps"]!)
                        {
                            if(g.Id == Model.GoiTapId)
                            {
                                <option value="@g.Id" selected>@g.TenGoi - @g.Gia.ToString("N0") VND</option>
                            }
                            else
                            {
                                <option value="@g.Id">@g.TenGoi - @g.Gia.ToString("N0") VND</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Ngày bắt đầu</label>
                    <input asp-for="NgayBatDau" class="form-control" type="date" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Ghi chú</label>
                    <textarea asp-for="GhiChu" class="form-control"></textarea>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <button class="btn btn-primary">Lưu</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
                    </div>
                    <div class="text-muted">Cập nhật số tính lại ngày kết thúc theo thời hạn gói.</div>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-4 d-none d-md-block">
        <div class="form-side-img shadow-sm">
            <img src="@Url.Content("~/images/phonggym2.jpg")" alt="side">
        </div>
    </div>
</div>