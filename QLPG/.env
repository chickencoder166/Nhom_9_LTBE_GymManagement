# Local environment overrides for QLPG
# ASP.NET Core will prefer this over appsettings.json once loaded by DotEnvLoader.

# IMPORTANT:
# Do not keep placeholder connection strings here (e.g. YOUR_SQL_SERVER),
# because they override appsettings/user-secrets and cause runtime DB errors.
# Set a real value only when needed, for example:
# ConnectionStrings__DefaultConnection=Server=localhost;Database=QLPG;User Id=sa;Password=Your_password123;TrustServerCertificate=True;MultipleActiveResultSets=true
